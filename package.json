{
  "name": "ultimo-rastro",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "qa:smoke": "node smoke-test.mjs",
    "qa:final": "node final-qa.mjs",
    "qa:av": "node final-qa-av.mjs",
    "assets:manifest": "node tools/assets/build-manifest.mjs",
    "assets:registry": "node tools/assets/build-registry.mjs",
    "audio:validate": "python3 tools/audio/validate.py",
    "qa:spatial": "node qa-spatial.mjs",
    "assets:models": "node tools/models/build-theo-glb.mjs && gltf-transform validate public/assets/models/theo.glb",
    "assets:theo": "node tools/art/build-theo-art.mjs && npm run assets:models",
    "godot:sync": "node tools/godot/sync-data.mjs && node tools/godot/build-layout-phase01.mjs && node tools/godot/sync-audio.mjs",
    "godot:import": "${GODOT:-godot} --headless --path godot --import",
    "godot:test": "${GODOT:-godot} --headless --path godot res://tests/test_runner.tscn",
    "godot:shots": "xvfb-run -a -s \"-screen 0 1280x720x24\" ${GODOT:-godot} --path godot --rendering-driver opengl3 --resolution 1280x720 res://tests/qa_shots.tscn -- --out=/tmp/ur_shots",
    "godot:play": "${GODOT:-godot} --path godot"
  },
  "dependencies": {
    "@babylonjs/core": "^9.28.0",
    "@babylonjs/loaders": "^9.28.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.0",
    "@gltf-transform/core": "^4.5.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
