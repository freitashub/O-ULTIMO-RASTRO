{
  "name": "ultimo-rastro",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "qa:smoke": "node smoke-test.mjs",
    "qa:final": "node final-qa.mjs",
    "qa:av": "node final-qa-av.mjs",
    "assets:manifest": "node tools/assets/build-manifest.mjs",
    "assets:registry": "node tools/assets/build-registry.mjs",
    "audio:validate": "python3 tools/audio/validate.py"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
